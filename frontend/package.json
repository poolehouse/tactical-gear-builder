{
  "name": "tactical-gear-builder-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "2D tactical gear loadout builder — the core-engine compiled to WebAssembly, running fully client-side.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:wasm": "wasm-pack build ../crates/wasm-engine --target web --out-dir ../../frontend/src/engine --out-name engine"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
